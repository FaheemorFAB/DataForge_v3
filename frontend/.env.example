# =============================================================================
#  DataForge v3 — Frontend Environment Variables (Example Template)
#  Copy this file to .env.local for development, or configure in Vercel / Netlify
# =============================================================================

# -- Backend API URL (Next.js rewrites /api/* calls to this address) -----------
# Local development default: http://localhost:5000
# Production deployment: https://api.yourdomain.com (or your Render/Railway backend URL)
NEXT_PUBLIC_API_URL=http://localhost:5000

# -- Frontend Application URL --------------------------------------------------
# Local development default: http://localhost:3000
# Production deployment: https://app.yourdomain.com (or your Vercel frontend URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Supabase Authentication & Database ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -- Resend Email API (Optional) -----------------------------------------------
RESEND_API_KEY=your-resend-api-key
