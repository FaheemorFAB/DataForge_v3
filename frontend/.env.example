# =============================================================================
#  DataForge v3 — Frontend Environment Variables Template
#  Copy to .env.local for local dev, or set directly in Vercel dashboard.
# =============================================================================

# -- Backend API URL (Next.js rewrites /api/* to this) -------------------------
# Local: http://localhost:5000
# Vercel production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# -- Frontend App URL ----------------------------------------------------------
# Local: http://localhost:3000
# Vercel production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -- Resend Email (server-side only) -------------------------------------------
RESEND_API_KEY=your-resend-api-key
# Verified sender address from your Resend domain
RESEND_FROM_EMAIL=notifications@yourdomain.com
