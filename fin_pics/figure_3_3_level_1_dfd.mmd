%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#fff', 'primaryTextColor': '#000', 'primaryBorderColor': '#000', 'lineColor': '#000', 'secondaryColor': '#fff', 'tertiaryColor': '#fff', 'fontFamily': 'arial', 'fontSize': '11px'}}}%%
flowchart TD
    classDef entity fill:#fff,stroke:#000,stroke-width:2px,color:#000;
    classDef process fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
    classDef store fill:#fff,stroke:#000,stroke-width:1.5px,stroke-dasharray:4 2,color:#000;

    E1["E1: User"]:::entity
    E2["E2: Sources"]:::entity
    E3["E3: Google OAuth"]:::entity
    E4["E4: Gemini AI"]:::entity
    E5["E5: Supabase"]:::entity
    E6["E6: Notifications"]:::entity

    D1[("D1: Users & Quotas")]:::store
    D2[("D2: Raw Datasets")]:::store
    D3[("D3: Clean Snapshots")]:::store
    D4[("D4: Baseline Cache")]:::store
    D5[("D5: Model Registry")]:::store
    D6[("D6: Audit Logs")]:::store

    P1(("1.0<br/>Auth")):::process
    P2(("2.0<br/>Ingest")):::process
    P3(("3.0<br/>Clean")):::process
    P4(("4.0<br/>EDA")):::process
    P5(("5.0<br/>AI")):::process
    P6(("6.0<br/>AutoML")):::process
    P7(("7.0<br/>Report")):::process

    %% Auth
    E1 -->|"Login"| P1
    E3 -->|"Claims"| P1
    P1 <-->|"User Profile"| D1
    P1 -->|"JWT Token"| E1

    %% Ingestion
    E1 -->|"Upload"| P2
    E2 -->|"Stream"| P2
    P2 -->|"Stage"| D2
    P2 -->|"Health Card"| E1

    %% Cleaning
    E1 -->|"Rules"| P3
    D2 -->|"Raw"| P3
    P3 -->|"Snapshot"| D3
    P3 -->|"Diff"| E1

    %% EDA
    D3 -->|"Clean DF"| P4
    P4 -->|"Stats"| D4
    P4 -->|"Charts"| E1

    %% AI Query
    E1 -->|"Query"| P5
    D3 -->|"Schema"| P5
    P5 <-->|"Prompt / Code"| E4
    P5 -->|"Answer"| E1

    %% AutoML
    E1 -->|"Target"| P6
    D3 -->|"Matrix"| P6
    P6 -->|"Weights"| D5
    P6 -->|"Metrics"| E1

    %% Reports
    D4 -->|"Insights"| P7
    P6 -->|"Scores"| P7
    P7 -->|"PDF / Deck"| E1
    P7 -->|"Alerts"| E6

    %% Storage & Logs
    D3 -.->|"Mirror"| E5
    D5 -.->|"Binaries"| E5
    P1 -.->|"Log"| D6
    P3 -.->|"Log"| D6
