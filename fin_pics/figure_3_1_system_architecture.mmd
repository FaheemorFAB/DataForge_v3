%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#fff', 'primaryTextColor': '#000', 'primaryBorderColor': '#000', 'lineColor': '#000', 'secondaryColor': '#fff', 'tertiaryColor': '#fff', 'fontFamily': 'arial', 'fontSize': '12px'}}}%%
flowchart TD
    classDef box fill:#fff,stroke:#000,stroke-width:1.5px,color:#000;
    classDef sub fill:#fff,stroke:#000,stroke-width:2px,stroke-dasharray:3 3,color:#000;

    subgraph L1["Presentation Layer (Next.js 15 / React)"]
        UI_AUTH["Auth & Workspace"]:::box
        UI_ING["Ingest & Schema"]:::box
        UI_CLN["Cleaning Studio"]:::box
        UI_EDA["EDA & Charts"]:::box
        UI_AI["AI Chat & AutoML"]:::box
    end

    subgraph L2["API & Gateway Layer (FastAPI)"]
        GW_SEC["Proxy & Security"]:::box
        GW_AUTH["JWT & RBAC"]:::box
        GW_API["Route Handlers"]:::box
        GW_WS["WebSocket & Queue"]:::box
    end

    subgraph L3["Processing Engine (Pandas / FLAML / Gemini)"]
        ENG_ING["Ingest & Validate"]:::box
        ENG_CLN["Cleaning & DAG"]:::box
        ENG_EDA["14 EDA Scanners"]:::box
        ENG_AI["AI Multi-Agent"]:::box
        ENG_ML["AutoML & ARIMA"]:::box
        ENG_REP["WeasyPrint PDF"]:::box
    end

    subgraph L4["Storage & Integrations"]
        DB_PG["PostgreSQL (Supabase)"]:::box
        DB_OBJ["Object Storage"]:::box
        EXT_OAUTH["Google OAuth 2.0"]:::box
        EXT_GEMINI["Google Gemini API"]:::box
        EXT_DATA["Sheets / DB Connectors"]:::box
    end

    L1 <-->|"HTTPS / WSS"| L2
    L2 <-->|"Dispatch / Result"| L3
    L3 <-->|"SQL / Parquet"| DB_PG
    L3 <-->|"Snapshots / Artifacts"| DB_OBJ
    L2 <-->|"Token Verify"| EXT_OAUTH
    L3 <-->|"Prompt / Code"| EXT_GEMINI
    ENG_ING <-->|"Fetch"| EXT_DATA
