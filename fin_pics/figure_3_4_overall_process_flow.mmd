%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#fff', 'primaryTextColor': '#000', 'primaryBorderColor': '#000', 'lineColor': '#000', 'secondaryColor': '#fff', 'tertiaryColor': '#fff', 'fontFamily': 'arial', 'fontSize': '11px'}}}%%
flowchart TD
    classDef step fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;
    classDef branch fill:#fff,stroke:#000,stroke-width:1.5px,stroke-dasharray:3 3,color:#000;
    classDef decision fill:#fff,stroke:#000,stroke-width:1.8px,color:#000;

    S1["1. Auth & Workspace<br/>(OAuth / Credentials / JWT)"]:::step
    S2["2. Data Ingestion<br/>(Files / DB / Schema Check)"]:::step
    S3["3. Cleaning & Pipeline<br/>(Dedupe / Impute / DAG)"]:::step
    S4["4. Automated EDA<br/>(14 Scanners / Metrics)"]:::step
    S5["5. AI Query & Insights<br/>(NLP / Sandboxed Code)"]:::step
    
    DEC{"Analysis Path?"}:::decision
    
    S6A["6A. AutoML Engine<br/>(FLAML Classification / Reg)"]:::branch
    S6B["6B. Time-Series<br/>(ARIMA / Prophet Forecast)"]:::branch
    S6C["6C. Direct BI<br/>(Ad-hoc Exploration)"]:::branch

    S7["7. Visualisation & Reports<br/>(Plotly Dashboard / PDF)"]:::step
    S8["8. Snapshots & Export<br/>(Parquet / Pipeline / Logs)"]:::step

    S1 --> S2 --> S3 --> S4 --> S5 --> DEC
    DEC -->|"Predictive"| S6A --> S7
    DEC -->|"Temporal"| S6B --> S7
    DEC -->|"Descriptive"| S6C --> S7
    S7 --> S8
