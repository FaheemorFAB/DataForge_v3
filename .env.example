# =============================================================================
#  DataForge v3 — Environment Variables (Production & Deployment Template)
#  Copy to .env and customize values before running or deploying
# =============================================================================

# -- Environment ---------------------------------------------------------------
# Set to 'true' in production (enables HTTPS secure cookies, enforces strict origin checks).
PRODUCTION=false

# -- Application URLs (Configure for Deployment) -------------------------------
# Where your frontend is hosted (e.g. https://yourdomain.com or https://dataforge.vercel.app)
FRONTEND_URL=http://localhost:3000

# Where your backend API is hosted (e.g. https://api.yourdomain.com or https://dataforge-backend.onrender.com)
BACKEND_URL=http://localhost:5000

# (Optional) Comma-separated list of additional allowed CORS origins.
# If omitted, FRONTEND_URL is used automatically.
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# -- Security ------------------------------------------------------------------
FLASK_SECRET_KEY=change-this-to-a-secure-random-64-character-string
JWT_SECRET=change-this-to-a-secure-random-64-character-string

# -- Google OAuth (Optional) ---------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth Redirect Callback URL (defaults to ${BACKEND_URL}/auth/google/callback if unset)
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# -- AI / Gemini API -----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -- Supabase Database & Auth --------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=dataforge-datasets

# -- Redis & Celery (Optional - used for distributed caching & async workers) ---
REDIS_URL=redis://localhost:6379/0

# -- Resend Email API (Optional) -----------------------------------------------
RESEND_API_KEY=your-resend-api-key

# -- Feature Flags -------------------------------------------------------------
DATAFORGE_SYNC_FALLBACK=1
ALLOW_LOCAL_DATABASE=false

# -- Lifetime Tier Whitelists (comma-separated emails) -------------------------
TEAM_TIER_EMAILS=
PRO_TIER_EMAILS=
